# Local only. Copy from the web app's .env.local. Do not put a live Stripe key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Set to 1 only to render synthetic layout previews. Never for a patient session.
EXPO_PUBLIC_PREVIEW=0
