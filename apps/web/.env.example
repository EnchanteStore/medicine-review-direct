# Local development only. Generate real local values with:
#   pnpm --filter @mrd/web env:local
# which reads `supabase status` and writes apps/web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Used only by Playwright to read captured emails from the local Mailpit inbox.
MAILPIT_URL=http://127.0.0.1:54324

# Local demo key written by `pnpm env:local`. Server-side payment webhook only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional. If unset, checkout uses the labelled local test harness and Stripe is not called.
# A live secret key (sk_live_) is refused. Do not paste a real value into git.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Staging auth callbacks. Ignored unless it is exactly https://staging.medsinfocus.co.uk
# STAGING_SITE_URL=

# SES in London. If any of these are unset, no SES message is sent. Do not paste values.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SES_REGION=eu-west-2
# SES_FROM_EMAIL=
# SES_SEND_ENABLED=
