# Local development only. Generate real local values with:
#   pnpm --filter @mrd/web env:local
# which reads `supabase status` and writes apps/web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Used only by Playwright to read captured emails from the local Mailpit inbox.
MAILPIT_URL=http://127.0.0.1:54324

# Local demo key written by `pnpm env:local`. Server-side payment webhook only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Optional. If unset, checkout uses the labelled local test harness.
# A live secret key (sk_live_) is refused.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
